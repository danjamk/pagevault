node_modules/
dist/
# cli/LICENSE is copied from the repo-root LICENSE by build-bundle.mjs at pack time, so it ships in
# the npm tarball without a second committed copy to keep in sync.
cli/LICENSE
.DS_Store
.idea/

# Claude workspace artifacts
# Most skills/ entries are symlinks into the private ~/yukon/claude-shared — local only,
# they would be dangling links for anyone who clones this. `lifecycle` is the exception:
# it is a real, self-contained file about THIS project's release ritual, so it ships.
.claude/settings.local.json
.claude/skills/*
!.claude/skills/lifecycle/
CLAUDE.local.md
COMMIT_MESSAGE.md
PR_COMMENT.md

# Secrets — never commit
.env.local
.dev.vars

# Wrangler
.wrangler/

# Written by `make provision`. Holds a real email, team name, Access AUD tags and KV
# namespace id — this is a public repo, and none of that belongs in it. The committed
# worker/wrangler.jsonc keeps its placeholders and is what the tests run against.
worker/wrangler.generated.jsonc
.pagevault-provision.json

# The ladder's per-clone intent + discovered state (account id, owner email, host, KV id).
# Per-clone and account-specific — never belongs on the public repo.
.pagevault.json

# KV backups (`make backup`). Contains your documents and portal data — keep it out of git.
pagevault-backup-*.json
pre-test.json

# Exports (`make export` / `pagevault export`). Your documents — keep them out of git.
pagevault-export-*
