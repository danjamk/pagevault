{
  "name": "pagevault",
  "version": "0.1.0",
  "description": "Publish self-contained HTML to your own PageVault deployment from the terminal.",
  "type": "module",
  "scripts": {
    "build": "node ../scripts/build-bundle.mjs",
    "prepack": "npm run build",
    "test": "node --test *.test.mjs",
    "smoke": "node smoke.mjs",
    "prepublishOnly": "npm test && npm run smoke"
  },
  "bin": {
    "pagevault": "bin/pagevault.mjs"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danjamk/pagevault.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/danjamk/pagevault#readme",
  "bugs": "https://github.com/danjamk/pagevault/issues",
  "keywords": [
    "pagevault",
    "html",
    "publish",
    "cloudflare",
    "cli",
    "sharing"
  ]
}
